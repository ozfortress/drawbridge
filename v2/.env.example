# Drawbridge v2 - bootstrap configuration. Copy to .env.local and fill in.
# Everything else is configured in the panel and stored in the database.
# Secrets are marked (S). Never commit a filled-in copy.

# all | web | bot | worker | migrate
RUN_MODE=all

# Postgres (dev compose maps 5433 to avoid the Citadel dev database on 5432)
DATABASE_URL=postgres://drawbridge:drawbridge@127.0.0.1:5433/drawbridge

# Master key for database-stored secrets (base64, 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRAWBRIDGE_MASTER_KEY=CHANGE_ME
DRAWBRIDGE_MASTER_KEY_ID=k1

# Discord application (test application during development)
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/auth/discord/callback

# Root admins (Discord user IDs, comma separated)
ROOT_ADMIN_DISCORD_IDS=

# Public URL of the panel (behind the reverse proxy in deployed environments)
PUBLIC_BASE_URL=http://localhost:8080

# Reverse proxy: `none`, `loopback`, or a comma separated CIDR list
TRUST_PROXY=none

# Citadel (read-only). Development default is the local Citadel dev instance.
CITADEL_API_BASE_URL=http://127.0.0.1:3000/api/v1/
CITADEL_PUBLIC_BASE_URL=https://ozfortress.com
LOGSTF_BASE_URL=https://logs.tf

# S3-compatible storage (MinIO in development and self-hosting)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=drawbridge
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=drawbridge
S3_SECRET_ACCESS_KEY=drawbridge

# Alerts webhook (optional)
ALERT_WEBHOOK_URL=

# Sharding: off | manager
DISCORD_SHARDING=off
DISCORD_SHARD_COUNT=auto

# Keep message activity for this many days (owner decision: two years)
RETENTION_DAYS=730

WEB_HOST=0.0.0.0
WEB_PORT=8080
LOG_LEVEL=info

# Development only: guilds where live Discord writes are allowed.
DEV_GUILD_ALLOWLIST=
